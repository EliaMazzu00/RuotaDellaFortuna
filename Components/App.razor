<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0418" />
    <meta name="description" content="Il tabellone delle frasi misteriose della Ruota della Fortuna, da giocare in casa su più schermi." />

    @* Il tabellone a schermo intero non va messo in cache dalle WebView dei telefoni. *@
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <base href="/" />
    <ResourcePreloader />

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RuotaDellaFortuna.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <ImportMap />
    <title>La Ruota della Fortuna</title>
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
